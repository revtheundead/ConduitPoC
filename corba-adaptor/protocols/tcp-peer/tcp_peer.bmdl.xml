<?xml version="1.0" encoding="UTF-8"?>
<!--
  BMDL Protocol Definition: TCP Peer

  Defines the wire protocol for the TCP server peer. The adaptor connects
  to this peer as a client.  Messages flow bidirectionally:

    - "receive" messages: sent by the TCP peer, decoded by the adaptor
    - "send" messages: encoded by the adaptor, sent to the TCP peer
    - no direction: bidirectional

  TODO: Replace placeholder messages with the actual protocol definition.
-->
<bmdl version="2.0">
  <defaults>
    <namespace>tcp_peer</namespace>
    <endian>big</endian>
  </defaults>

  <!-- =================================================================== -->
  <!-- Primitive types                                                      -->
  <!-- =================================================================== -->
  <types>
    <type name="uint8"   base="uint" bits="8"/>
    <type name="uint16"  base="uint" bits="16"/>
    <type name="uint32"  base="uint" bits="32"/>
    <type name="uint64"  base="uint" bits="64"/>
    <type name="int16"   base="int"  bits="16"/>
    <type name="int32"   base="int"  bits="32"/>
    <type name="float32" base="float" bits="32"/>
    <type name="bool8"   base="bool"  bits="8"/>

    <!-- Protocol-specific types (placeholders — refine as needed) -->
    <type name="msg-type" base="uint" bits="8">
      <enum>
        <value id="1"  name="heartbeat"/>
        <value id="2"  name="status-report"/>
        <value id="3"  name="data-payload"/>
        <value id="10" name="command-request"/>
        <value id="11" name="command-response"/>
        <value id="20" name="config-update"/>
      </enum>
    </type>

    <type name="status-code" base="uint" bits="8">
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="warning"/>
        <value id="2" name="error"/>
        <value id="3" name="offline"/>
      </enum>
    </type>

    <type name="status-flags" base="uint" bits="16">
      <flags>
        <flag bit="0"  name="link-active"/>
        <flag bit="1"  name="data-valid"/>
        <flag bit="2"  name="config-loaded"/>
        <flag bit="3"  name="peer-connected"/>
        <flag bit="8"  name="error-overflow"/>
        <flag bit="9"  name="error-timeout"/>
        <flag bit="10" name="error-checksum"/>
      </flags>
    </type>
  </types>

  <!-- =================================================================== -->
  <!-- Frame definition                                                     -->
  <!--                                                                      -->
  <!-- Wire format:                                                         -->
  <!--   [sync:2][msg-type:1][length:2][payload...][checksum:1]             -->
  <!--                                                                      -->
  <!-- The sync pattern allows stream framing; length is auto-computed.     -->
  <!-- TODO: Adjust sync pattern, length width, and checksum to match the   -->
  <!--       actual wire protocol.                                          -->
  <!-- =================================================================== -->
  <frame name="TcpPeerFrame">
    <field name="sync"     type="uint16" value="0xCAFE"/>
    <field name="msg-id"   type="uint8"  auto="id"/>
    <field name="length"   type="uint16" auto="length"/>
    <payload/>
  </frame>

  <!-- =================================================================== -->
  <!-- Messages                                                             -->
  <!-- =================================================================== -->

  <!-- Heartbeat: bidirectional keep-alive -->
  <message id="1" name="Heartbeat">
    <field name="sequence"  type="uint32"/>
    <field name="timestamp" type="uint64"/>
  </message>

  <!-- Status report: received from TCP peer -->
  <message id="2" name="StatusReport" direction="receive">
    <field name="status"      type="status-code"/>
    <field name="flags"       type="status-flags"/>
    <field name="uptime-secs" type="uint32"/>
    <field name="error-count" type="uint16"/>
  </message>

  <!-- Data payload: received from TCP peer, forwarded to CORBA consumers -->
  <message id="3" name="DataPayload" direction="receive">
    <field name="channel-id"  type="uint8"/>
    <field name="sequence"    type="uint32"/>
    <field name="data-length" type="uint16"/>
    <field name="data"        bytes="256"/>  <!-- TODO: adjust to actual max payload -->
  </message>

  <!-- Command request: sent to TCP peer by the adaptor -->
  <message id="10" name="CommandRequest" direction="send">
    <field name="command-id"   type="uint16"/>
    <field name="param-length" type="uint8"/>
    <field name="params"       bytes="64"/>  <!-- TODO: adjust -->
  </message>

  <!-- Command response: received from TCP peer -->
  <message id="11" name="CommandResponse" direction="receive">
    <field name="command-id"     type="uint16"/>
    <field name="result-code"    type="status-code"/>
    <field name="result-length"  type="uint8"/>
    <field name="result-data"    bytes="64"/>  <!-- TODO: adjust -->
  </message>

  <!-- Config update: sent to TCP peer -->
  <message id="20" name="ConfigUpdate" direction="send">
    <field name="config-key"    type="uint16"/>
    <field name="config-length" type="uint8"/>
    <field name="config-data"   bytes="128"/>  <!-- TODO: adjust -->
  </message>
</bmdl>
