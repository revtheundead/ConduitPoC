// SPDX-License-Identifier: MIT
// Conduit CORBA Adaptor - Interface Definitions
//
// Defines the CORBA interfaces for the adaptor bridge. The adaptor exposes:
//
//   - A CommandReceiver for external control / queries
//   - A set of typed, named Supplier/Consumer interface pairs — one per
//     decoded message type — registered in the CORBA Naming Service. Each
//     supplier exposes a constant string NAME so that consumers can look it
//     up without hard-coded knowledge of the binding path.
//   - A bidirectional RawDataChannel used to bridge the CORBA-side peer's
//     byte stream (the adaptor is the client of that channel; framing and
//     codec are handled internally by Conduit, not by this IDL).
//
// There is NO dynamic filtering. Consumers select a supplier by resolving
// the name they are interested in from the Naming Service, and any data
// they receive through that supplier is already fully typed.

module CorbaAdaptor
{
    // ========================================================================
    // Common types
    // ========================================================================

    typedef sequence<octet> OctetSeq;
    typedef unsigned long   SubscriptionId;

    // ========================================================================
    // Command interface
    // ========================================================================

    enum CommandStatus {
        CMD_OK,
        CMD_REJECTED,
        CMD_ERROR
    };

    struct CommandResult {
        CommandStatus   status;
        string          message;
    };

    /// Receives commands from external systems. Registered in the Naming
    /// Service under the NAME constant below.
    interface CommandReceiver {
        const string NAME = "CorbaAdaptor/CommandReceiver";

        /// Execute an arbitrary command with optional binary parameters.
        CommandResult execute_command(in string command, in OctetSeq params);

        /// Query a named value / status.
        CommandResult query(in string name);

        /// Request graceful shutdown of the adaptor.
        oneway void request_shutdown();
    };

    // ========================================================================
    // Base supplier / consumer interfaces
    // ========================================================================
    //
    // Every typed supplier/consumer pair inherits from these bases so that
    // subscription management and health checking can be implemented once
    // in C++ (via a template servant) rather than duplicated per message.
    // ========================================================================

    /// Common lifecycle callbacks implemented by every typed consumer.
    interface BaseConsumer {
        /// Heartbeat probe — returns true if the consumer is healthy.
        boolean is_alive();

        /// Called by the supplier when it is shutting down.
        oneway void on_supplier_disconnect(in string reason);
    };

    /// Common subscription management implemented by every typed supplier.
    interface BaseSupplier {
        /// Remove an existing subscription.
        void unsubscribe(in SubscriptionId id);

        /// Return the number of active subscriptions.
        unsigned long subscriber_count();
    };

    // ========================================================================
    // Typed messages: TCP peer
    // ========================================================================
    //
    // These structs mirror the BMDL definitions in protocols/tcp-peer/
    // tcp_peer.bmdl.xml. The adaptor converts between the bgen-generated
    // C++ structs and these CORBA types before publishing.
    // ========================================================================

    struct HeartbeatMsg {
        unsigned long       sequence;
        unsigned long long  timestamp;
    };

    struct StatusReportMsg {
        octet           status;         // status-code
        unsigned short  flags;          // status-flags
        unsigned long   uptime_secs;
        unsigned short  error_count;
    };

    struct DataPayloadMsg {
        octet           channel_id;
        unsigned long   sequence;
        unsigned short  data_length;
        OctetSeq        data;
    };

    struct CommandResponseMsg {
        unsigned short  command_id;
        octet           result_code;    // status-code
        OctetSeq        result_data;
    };

    // ========================================================================
    // Typed messages: CORBA peer
    // ========================================================================
    //
    // Mirror the BMDL definitions in protocols/corba-peer/corba_peer.bmdl.xml.
    // ========================================================================

    struct TelemetryMsg {
        unsigned short      source_id;
        unsigned long       sequence;
        unsigned long long  timestamp;
        octet               channel;
        float               value;
    };

    struct EventMsg {
        unsigned short      source_id;
        unsigned long long  timestamp;
        unsigned short      event_code;
        octet               severity;
        OctetSeq            data;
    };

    struct AlarmMsg {
        unsigned short      source_id;
        unsigned long long  timestamp;
        unsigned short      alarm_id;
        octet               severity;
        octet               flags;
    };

    // ========================================================================
    // Typed supplier / consumer pairs — TCP peer side
    // ========================================================================

    interface HeartbeatConsumer : BaseConsumer {
        oneway void on_heartbeat(in HeartbeatMsg msg);
    };
    interface HeartbeatSupplier : BaseSupplier {
        const string NAME = "CorbaAdaptor/Heartbeat";
        SubscriptionId subscribe(in HeartbeatConsumer consumer);
    };

    interface StatusReportConsumer : BaseConsumer {
        oneway void on_status_report(in StatusReportMsg msg);
    };
    interface StatusReportSupplier : BaseSupplier {
        const string NAME = "CorbaAdaptor/StatusReport";
        SubscriptionId subscribe(in StatusReportConsumer consumer);
    };

    interface DataPayloadConsumer : BaseConsumer {
        oneway void on_data_payload(in DataPayloadMsg msg);
    };
    interface DataPayloadSupplier : BaseSupplier {
        const string NAME = "CorbaAdaptor/DataPayload";
        SubscriptionId subscribe(in DataPayloadConsumer consumer);
    };

    interface CommandResponseConsumer : BaseConsumer {
        oneway void on_command_response(in CommandResponseMsg msg);
    };
    interface CommandResponseSupplier : BaseSupplier {
        const string NAME = "CorbaAdaptor/CommandResponse";
        SubscriptionId subscribe(in CommandResponseConsumer consumer);
    };

    // ========================================================================
    // Typed supplier / consumer pairs — CORBA peer side
    // ========================================================================

    interface TelemetryConsumer : BaseConsumer {
        oneway void on_telemetry(in TelemetryMsg msg);
    };
    interface TelemetrySupplier : BaseSupplier {
        const string NAME = "CorbaAdaptor/Telemetry";
        SubscriptionId subscribe(in TelemetryConsumer consumer);
    };

    interface EventConsumer : BaseConsumer {
        oneway void on_event(in EventMsg msg);
    };
    interface EventSupplier : BaseSupplier {
        const string NAME = "CorbaAdaptor/Event";
        SubscriptionId subscribe(in EventConsumer consumer);
    };

    interface AlarmConsumer : BaseConsumer {
        oneway void on_alarm(in AlarmMsg msg);
    };
    interface AlarmSupplier : BaseSupplier {
        const string NAME = "CorbaAdaptor/Alarm";
        SubscriptionId subscribe(in AlarmConsumer consumer);
    };

    // ========================================================================
    // CORBA raw-data peer transport
    // ========================================================================
    //
    // Unlike the TCP peer (which is driven end-to-end by Conduit — transport
    // and codec), the CORBA peer exposes its wire protocol as raw bytes over
    // CORBA, so the adaptor needs these interfaces to move bytes in and out.
    // Decoding/encoding still happens inside the adaptor via a Conduit
    // ISession; no raw bytes ever escape to consumers.
    // ========================================================================

    /// Callback for receiving inbound raw data from the CORBA peer.
    interface RawDataCallback {
        /// Deliver raw bytes received from the remote side.
        oneway void on_raw_data(in OctetSeq data);

        /// Notify that the channel has disconnected.
        oneway void on_channel_disconnect(in string reason);
    };

    /// Bidirectional raw byte channel exposed by the CORBA peer.
    interface RawDataChannel {
        /// Send raw bytes to the remote side.
        void send_raw(in OctetSeq data);

        /// Register a callback for inbound data.
        void register_callback(in RawDataCallback cb);

        /// Remove the callback.
        void unregister_callback();

        /// Check whether the remote side is connected.
        boolean is_connected();
    };
};
