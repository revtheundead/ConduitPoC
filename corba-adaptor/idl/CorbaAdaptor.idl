// SPDX-License-Identifier: MIT
// Conduit CORBA Adaptor - Interface Definitions
//
// Two layers:
//
//   Base layer (reusable across applications)
//   ------------------------------------------
//   BaseConsumer and BaseSupplier handle subscription lifecycle, health
//   checking, and disconnect notification.  Any application can derive
//   from these to build its own typed pub/sub topology.  subscribe()
//   lives on BaseSupplier and takes a BaseConsumer, so a supplier is
//   never locked to a single consumer type and a consumer can subscribe
//   to any supplier that accepts it.
//
//   Application layer (specific to this adaptor)
//   ---------------------------------------------
//   AdaptorConsumer extends BaseConsumer with typed on_xxx() callbacks
//   for every message the adaptor can publish.  AdaptorSupplier extends
//   BaseSupplier with nothing extra — subscribe() is inherited.  Clients
//   look up the supplier by its NAME constant in the Naming Service,
//   subscribe with their AdaptorConsumer servant, and receive whichever
//   typed callbacks the supplier fires.  Callbacks the consumer does not
//   care about can be implemented as empty stubs.
//
// IDL type choices
// ----------------
// All integer fields use signed types (`long`, `long long`, `short`) for
// maximum IDL-compiler portability.  Unsigned variants (`unsigned long`,
// `unsigned long long`) cause syntax errors on some tao_idl versions.

module CorbaAdaptor
{
    // ====================================================================
    // Common types
    // ====================================================================

    typedef sequence<octet> OctetSeq;

    // ====================================================================
    // Base supplier / consumer interfaces (reusable)
    // ====================================================================
    //
    // These are intentionally minimal so that any application can
    // implement them with basic C++ (std::mutex, std::map, std::vector).
    // No templates, no advanced language features required.
    // ====================================================================

    /// Common lifecycle callbacks implemented by every consumer.
    interface BaseConsumer {
        /// Health-check probe — returns TRUE if the consumer is healthy.
        boolean is_alive();

        /// Called by the supplier when it is shutting down.
        oneway void on_supplier_disconnect(in string reason);
    };

    /// Common subscription management implemented by every supplier.
    /// subscribe() accepts any BaseConsumer; the supplier narrows to the
    /// concrete consumer type internally and silently skips consumers
    /// whose type does not match.
    interface BaseSupplier {
        /// Add a new subscription.  Returns a positive id on success.
        long subscribe(in BaseConsumer consumer);

        /// Remove an existing subscription.
        void unsubscribe(in long subscription_id);

        /// Return the number of active subscriptions.
        long subscriber_count();
    };

    // ====================================================================
    // Command interface
    // ====================================================================

    enum CommandStatus {
        CMD_OK,
        CMD_REJECTED,
        CMD_ERROR
    };

    struct CommandResult {
        CommandStatus   status;
        string          message;
    };

    /// Receives commands from external systems.  Registered in the
    /// Naming Service under the NAME constant below.
    interface CommandReceiver {
        const string NAME = "CorbaAdaptor/CommandReceiver";

        /// Execute an arbitrary command with optional binary parameters.
        CommandResult execute_command(in string command, in OctetSeq params);

        /// Query a named value / status.
        CommandResult query(in string name);

        /// Request graceful shutdown of the adaptor.
        oneway void request_shutdown();
    };

    // ====================================================================
    // Adaptor message types — TCP peer
    // ====================================================================
    //
    // Mirror the BMDL definitions in protocols/tcp-peer/tcp_peer.bmdl.xml.
    // ====================================================================

    struct HeartbeatMsg {
        long        sequence;
        long long   timestamp;
    };

    struct StatusReportMsg {
        octet           status;
        unsigned short  flags;
        long            uptime_secs;
        unsigned short  error_count;
    };

    struct DataPayloadMsg {
        octet           channel_id;
        long            sequence;
        unsigned short  data_length;
        OctetSeq        data;
    };

    struct CommandResponseMsg {
        unsigned short  command_id;
        octet           result_code;
        OctetSeq        result_data;
    };

    // ====================================================================
    // Adaptor message types — CORBA peer
    // ====================================================================
    //
    // Mirror the BMDL definitions in protocols/corba-peer/
    // corba_peer.bmdl.xml.
    // ====================================================================

    struct TelemetryMsg {
        unsigned short  source_id;
        long            sequence;
        long long       timestamp;
        octet           channel;
        float           value;
    };

    struct EventMsg {
        unsigned short  source_id;
        long long       timestamp;
        unsigned short  event_code;
        octet           severity;
        OctetSeq        data;
    };

    struct AlarmMsg {
        unsigned short  source_id;
        long long       timestamp;
        unsigned short  alarm_id;
        octet           severity;
        octet           flags;
    };

    // ====================================================================
    // Adaptor consumer / supplier
    // ====================================================================
    //
    // A single consumer interface carries callbacks for every message
    // type the adaptor can publish.  A single supplier holds all
    // subscriptions.  This means:
    //
    //   - Adding a new message type = add one on_xxx() callback here
    //     and one publish method in the C++ servant.
    //   - A consumer that only cares about heartbeats implements
    //     on_heartbeat() and leaves the other callbacks as empty stubs.
    //   - Multiple suppliers are possible (e.g. split by peer) by
    //     defining new <X>Supplier : BaseSupplier interfaces with
    //     their own NAME constants — no IDL framework changes needed.
    // ====================================================================

    /// Receives all adaptor message types via typed callbacks.
    interface AdaptorConsumer : BaseConsumer {
        oneway void on_heartbeat(in HeartbeatMsg msg);
        oneway void on_status_report(in StatusReportMsg msg);
        oneway void on_data_payload(in DataPayloadMsg msg);
        oneway void on_command_response(in CommandResponseMsg msg);
        oneway void on_telemetry(in TelemetryMsg msg);
        oneway void on_event(in EventMsg msg);
        oneway void on_alarm(in AlarmMsg msg);
    };

    /// Publishes adaptor data to subscribed consumers.
    /// Registered in the Naming Service under NAME.
    interface AdaptorSupplier : BaseSupplier {
        const string NAME = "CorbaAdaptor/Supplier";
    };

    // ====================================================================
    // CORBA raw-data peer transport
    // ====================================================================
    //
    // The CORBA peer's wire protocol is raw bytes over CORBA (we cannot
    // replace its transport).  Decoding/encoding happens inside the
    // adaptor via a Conduit ISession; no raw bytes escape to consumers.
    // ====================================================================

    /// Callback for receiving inbound raw data from the CORBA peer.
    interface RawDataCallback {
        /// Deliver raw bytes received from the remote side.
        oneway void on_raw_data(in OctetSeq data);

        /// Notify that the channel has disconnected.
        oneway void on_channel_disconnect(in string reason);
    };

    /// Bidirectional raw byte channel exposed by the CORBA peer.
    interface RawDataChannel {
        /// Send raw bytes to the remote side.
        void send_raw(in OctetSeq data);

        /// Register a callback for inbound data.
        void register_callback(in RawDataCallback cb);

        /// Remove the callback.
        void unregister_callback();

        /// Check whether the remote side is connected.
        boolean is_connected();
    };
};
