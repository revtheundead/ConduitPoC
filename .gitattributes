# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always use LF, even on Windows checkouts
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts should use CRLF on Windows checkouts
*.ps1 text eol=crlf
