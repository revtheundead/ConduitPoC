      </field>
    </struct>

    <!-- I007/450 Compound Item -->
    <struct name="Cat007I450">
      <doc>
        I007/450 - Directed Interrogation Result
        Compound data item with FX-extensible primary subfield.
        Subfield #1: Truncation (1 octet)
        Subfield #2: Mode 4 Interrogations (1 octet)
        Subfield #3: Mode 5 Interrogations (1 octet)
        Subfield #4: Mode S All Call Interrogations (2 octets)
        Subfield #5: Mark X Interrogations (1 octet)
        Subfield #6: Selective Mode S Interrogations (1 octet)
      </doc>
      <struct name="sub" presence="bitmap">
        <bitmap ext="7"/>
        <field name="tr" bit="0" type="Cat007I450Tr">
          <doc>Subfield #1: Truncation</doc>
        </field>
        <field name="m4Nb" bit="1" type="uint8">
          <doc>Subfield #2: Number of Mode 4 Interrogations</doc>
        </field>
        <field name="m5Nb" bit="2" type="uint8">
          <doc>Subfield #3: Number of Mode 5 Interrogations</doc>
        </field>
        <field name="ms" bit="3" type="Cat007I450Ms">
          <doc>Subfield #4: Mode S All Call Interrogations</doc>
        </field>
        <field name="mxNb" bit="4" type="uint8">
          <doc>Subfield #5: Number of Mark X Interrogations</doc>
        </field>
        <field name="smsNb" bit="5" type="uint8">
          <doc>Subfield #6: Number of Selective Mode S Interrogations</doc>
        </field>
      </struct>
    </struct>

  </types>

