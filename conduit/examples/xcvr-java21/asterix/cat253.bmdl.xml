<?xml version="1.0" encoding="UTF-8"?>
<!--
  ASTERIX Category 253 - Remote Monitoring and Control
  Issue 9.0 (ASTERIX CATEGORY 253 SPECIFICATION V9)

  Proposed Standard UAP with 2 FSPEC octets (14 FRN positions).

  Implemented message types (I253/040 MIT):
    8  - Command
    9  - Complete Status Transfer
    10 - Delta Status Transfer
    11 - Complete Status Transfer Request
    18 - Acknowledgement
    19 - Error

  I080 START INDEX determines the data structure in I100.
  I090 is included but not used.

  I100 variant structures (standalone types, decoded by application):
    - Cat253Multipath     (START INDEX 0x0005)
    - Cat253Squitter      (START INDEX 0x0006)
    - Cat253BitReport     (START INDEX 0x0023)
-->
<bmdl version="2.0">
  <import href="types.bmdl.xml"/>

  <types>

    <!-- ===================================================================
         Enum Types
         =================================================================== -->

    <!-- I253/040 Message Type Identifier (6 bits) -->
    <type name="Cat253MsgType" base="uint" bits="6">
      <doc>
        Message Type Identification:
        1 = Time and Day, 2 = Connect Request, 3 = Connect Response,
        4 = Connect Release, 5 = Command Token Request,
        6 = Command Token Release, 7 = Command Token Assign,
        8 = Command, 9 = Complete Status Transfer,
        10 = Delta Status Transfer, 11 = Complete Status Transfer Request,
        12 = Centre Exchange, 13 = Centre Status,
        14 = Centre Transparent, 15 = Centre Resynch Request,
        16 = Radar Monitor Start, 17 = Radar Monitor Stop,
        18 = Acknowledgement, 19 = Error, 20 = Alarm, 21 = Alive
      </doc>
      <enum>
        <value id="1" name="TimeAndDay"/>
        <value id="2" name="ConnectRequest"/>
        <value id="3" name="ConnectResponse"/>
        <value id="4" name="ConnectRelease"/>
        <value id="5" name="CommandTokenRequest"/>
        <value id="6" name="CommandTokenRelease"/>
        <value id="7" name="CommandTokenAssign"/>
        <value id="8" name="command"/>
        <value id="9" name="CompleteStatusTransfer"/>
        <value id="10" name="DeltaStatusTransfer"/>
        <value id="11" name="CompleteStatusTransferRequest"/>
        <value id="12" name="CentreExchange"/>
        <value id="13" name="CentreStatus"/>
        <value id="14" name="CentreTransparent"/>
        <value id="15" name="CentreResynchRequest"/>
        <value id="16" name="RadarMonitorStart"/>
        <value id="17" name="RadarMonitorStop"/>
        <value id="18" name="acknowledgement"/>
        <value id="19" name="error"/>
        <value id="20" name="alarm"/>
        <value id="21" name="alive"/>
      </enum>
    </type>

    <!-- =================================================================
         I100 Variant Enum Types - Multipath (mp- prefix)
         ================================================================= -->

    <type name="Cat253MpDetection" base="uint" bits="4">
      <doc>Multipath detection: 0x0 = Disabled, 0x1 = Enabled</doc>
      <enum>
        <value id="0" name="disabled"/>
        <value id="1" name="enabled"/>
      </enum>
    </type>

    <type name="Cat253MpLevel" base="uint" bits="4">
      <doc>Multipath level (LSB = 1 dB, range 0-6 dB)</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- =================================================================
         I100 Variant Enum Types - Squitter (sq- prefix)
         ================================================================= -->

    <type name="Cat253SqRxChannel" base="uint" bits="4">
      <doc>Squitter receiving channel: 0x0 = SUM, 0x1 = DIFF, 0x2 = SUM+DIFF</doc>
      <enum>
        <value id="0" name="sum"/>
        <value id="1" name="diff"/>
        <value id="2" name="SumDiff"/>
      </enum>
    </type>

    <type name="Cat253SqMsSquitter" base="uint" bits="1">
      <doc>Mode S Squitter</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
      </enum>
    </type>

    <type name="Cat253SqM5Squitter" base="uint" bits="1">
      <doc>Mode 5 Squitter</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
      </enum>
    </type>

    <!-- =================================================================
         I100 Variant Enum Types - BitReport (br- prefix)
         ================================================================= -->

    <!-- Octet 2 -->
    <type name="Cat253BrBitType" base="uint" bits="4">
      <doc>BIT Type</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrSuccessState" base="uint" bits="4">
      <doc>Success State</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 3 -->
    <type name="Cat253BrAntennaGeneral" base="uint" bits="4">
      <doc>Antenna General Response</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrAntennaScanError" base="uint" bits="4">
      <doc>Antenna Scan Error</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 4 -->
    <type name="Cat253BrPowerSourceGeneral" base="uint" bits="4">
      <doc>Power Source General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 5 -->
    <type name="Cat253BrCtrlUnitGeneral" base="uint" bits="2">
      <doc>Control Unit General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrKbCryptoComm" base="uint" bits="2">
      <doc>KB Crypto Communication</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrKbRtc" base="uint" bits="2">
      <doc>KB RTC</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrKbHeatWarning" base="uint" bits="2">
      <doc>KB Heat Warning</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 6 -->
    <type name="Cat253BrBottomBandGeneral" base="uint" bits="4">
      <doc>General Bottom Band</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrTbCtrlComm" base="uint" bits="2">
      <doc>TB Control Unit Communication</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrTbConfigUpload" base="uint" bits="2">
      <doc>TB Config Upload</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 7 -->
    <type name="Cat253BrVswrGeneral" base="uint" bits="2">
      <doc>VSWR General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrVswrSum" base="uint" bits="2">
      <doc>VSWR Sum</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrVswrDiff" base="uint" bits="2">
      <doc>VSWR Difference</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrVswrOmni" base="uint" bits="2">
      <doc>VSWR Omni</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 8 -->
    <type name="Cat253BrAfbGeneral" base="uint" bits="4">
      <doc>AFB General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrAfbMainSynth" base="uint" bits="2">
      <doc>AFB Main Synthesizer</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 9 -->
    <type name="Cat253BrAfbBitSynth" base="uint" bits="2">
      <doc>AFB BIT Synthesizer</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrAfbTotalCh" base="uint" bits="2">
      <doc>AFB Total Channel</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrAfbDiffCh" base="uint" bits="2">
      <doc>AFB Difference Channel</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrAfbOmniCh" base="uint" bits="2">
      <doc>AFB Omni Channel</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 10 -->
    <type name="Cat253BrRfgybGeneral" base="uint" bits="4">
      <doc>RFGYB General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrRfgybTotalPwr" base="uint" bits="2">
      <doc>RFGYB Total Output Power</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrRfgybDiffPwr" base="uint" bits="2">
      <doc>RFGYB Difference Output Power</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 11 -->
    <type name="Cat253BrRfgybOmniPwr" base="uint" bits="2">
      <doc>RFGYB Omni Output Power</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrRfgybHeatWarning" base="uint" bits="2">
      <doc>RFGYB Heat Warning</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="Cat253BrCryptoGeneral" base="uint" bits="4">
      <doc>Crypto General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- ===================================================================
         Cat253-specific Binary Enum Types
         =================================================================== -->

    <!-- I253/040 Priority Indicator (1 bit) -->
    <type name="Cat253Priority" base="uint" bits="1">
      <doc>Priority Indicator: 0 = Normal, 1 = High priority</doc>
      <enum>
        <value id="0" name="Normal"/>
        <value id="1" name="High"/>
      </enum>
    </type>

    <!-- I253/040 Direction (1 bit) -->
    <type name="Cat253Direction" base="uint" bits="1">
      <doc>Direction: 0 = Request, 1 = Response</doc>
      <enum>
        <value id="0" name="Request"/>
        <value id="1" name="Response"/>
      </enum>
    </type>

    <!-- I253/080 Stale Indicator (1 bit) -->
    <type name="Cat253StaleInd" base="uint" bits="1">
      <doc>Stale indicator: 0 = Current, 1 = Stale</doc>
      <enum>
        <value id="0" name="Current"/>
        <value id="1" name="Stale"/>
      </enum>
    </type>

    <!-- I253/080 Local Control (1 bit) -->
    <type name="Cat253LocalCtrl" base="uint" bits="1">
      <doc>Local control: 0 = Not under local control, 1 = Under local control</doc>
      <enum>
        <value id="0" name="NotLocal"/>
        <value id="1" name="Local"/>
      </enum>
    </type>

    <!-- I253/080 Data Included (1 bit) -->
    <type name="Cat253DataIncl" base="uint" bits="1">
      <doc>Data included: 0 = No data in I100, 1 = Data included in I100</doc>
      <enum>
        <value id="0" name="NoData"/>
        <value id="1" name="DataIncluded"/>
      </enum>
    </type>

    <!-- ===================================================================
         Data Item Structs
         =================================================================== -->

    <!-- =======================================================================
         I253/025 - Data Destination Identifier + Local ID
         Repetitive: REP(8) + N * (SAC(8) + SIC(8) + LocalId(8))
         ======================================================================= -->
    <struct name="Cat253I025">
      <doc>I253/025 - Data Destination Identifier and Local Data Destination ID</doc>
      <field name="rep" type="uint8" auto="count(destinations)">
        <doc>Repetition factor</doc>
      </field>
      <array name="destinations" count-from="rep">
        <field name="sac" type="uint8">
          <doc>System Area Code of destination</doc>
        </field>
        <field name="sic" type="uint8">
          <doc>System Identification Code of destination</doc>
        </field>
        <field name="localId" type="uint8">
          <doc>Local Data Destination Identifier</doc>
        </field>
      </array>
    </struct>

    <!-- =======================================================================
         I253/035 - Data Origin Identifier
         Fixed 3 octets: OAC(8) + OIC(8) + LocalId(8)
         ======================================================================= -->
    <struct name="Cat253I035">
      <doc>I253/035 - Data Origin Identifier</doc>
      <field name="oac" type="uint8">
        <doc>Origin Area Code</doc>
      </field>
      <field name="oic" type="uint8">
        <doc>Origin Identification Code</doc>
      </field>
      <field name="localId" type="uint8">
        <doc>Origin Local Identifier</doc>
      </field>
    </struct>

    <!-- =======================================================================
         I253/040 - Message Type Identifier
         Fixed 1 octet: PI(1) + D(1) + MIT(6 enum)
         ======================================================================= -->
    <struct name="Cat253I040">
      <doc>I253/040 - Message Type Identifier</doc>
      <field name="pi" type="Cat253Priority">
        <doc>Priority indicator</doc>
      </field>
      <field name="d" type="Cat253Direction">
        <doc>Direction</doc>
      </field>
      <field name="mit" type="Cat253MsgType">
        <doc>Message Type Identification</doc>
      </field>
    </struct>

    <!-- =======================================================================
         I253/050 - Message Sequence Identifier
         Repetitive: REP(8) + N * MSID(16)
         ======================================================================= -->
    <struct name="Cat253I050">
      <doc>I253/050 - Message Sequence Identifier</doc>
      <field name="rep" type="uint8" auto="count(sequences)">
        <doc>Repetition factor</doc>
      </field>
      <array name="sequences" count-from="rep">
        <field name="msid" type="uint16">
          <doc>Message Sequence Identifier</doc>
        </field>
      </array>
    </struct>

    <!-- =======================================================================
         I253/060 - Blocking Information
         Fixed 2 octets: TNB(8) + BN(8)
         ======================================================================= -->
    <struct name="Cat253I060">
      <doc>I253/060 - Blocking Information</doc>
      <field name="tnb" type="uint8">
        <doc>Total Number of Blocks</doc>
      </field>
      <field name="bn" type="uint8">
        <doc>Block Number</doc>
      </field>
    </struct>

    <!-- =======================================================================
         I253/080 - Application Data Structure
         Variable length (FX chain, 4 bytes per extent)
         Each extent: start-index(16) + count(8) + stale(1) + sim(1) +
                      local-ctrl(1) + data-included(1) + spare(3) + FX(1)
         Up to 4 nesting levels.
         ======================================================================= -->
    <struct name="Cat253I080">
      <doc>I253/080 - Application Data Structure</doc>
      <field name="startIndex" type="uint16">
        <doc>Start Index (determines data structure in I100)</doc>
      </field>
      <field name="count" type="uint8">
        <doc>Number of data items</doc>
      </field>
      <field name="stale" type="Cat253StaleInd">
        <doc>Stale indicator</doc>
      </field>
      <field name="sim" type="SimIndicator">
        <doc>Simulation indicator</doc>
      </field>
      <field name="localCtrl" type="Cat253LocalCtrl">
        <doc>Local control</doc>
      </field>
      <field name="dataIncluded" type="Cat253DataIncl">
        <doc>Data included</doc>
      </field>
      <reserved bits="3"/>
      <fx>
        <field name="startIndex1" type="uint16">
          <doc>Start Index (second extent)</doc>
        </field>
        <field name="count1" type="uint8">
          <doc>Number of data items (second extent)</doc>
        </field>
        <field name="stale1" type="Cat253StaleInd">
          <doc>Stale indicator (second extent)</doc>
        </field>
        <field name="sim1" type="SimIndicator">
          <doc>Simulation indicator (second extent)</doc>
        </field>
        <field name="localCtrl1" type="Cat253LocalCtrl">
          <doc>Local control (second extent)</doc>
        </field>
        <field name="dataIncluded1" type="Cat253DataIncl">
          <doc>Data included (second extent)</doc>
        </field>
        <reserved bits="3"/>
        <fx>
          <field name="startIndex2" type="uint16">
            <doc>Start Index (third extent)</doc>
          </field>
          <field name="count2" type="uint8">
            <doc>Number of data items (third extent)</doc>
          </field>
          <field name="stale2" type="Cat253StaleInd">
            <doc>Stale indicator (third extent)</doc>
          </field>
          <field name="sim2" type="SimIndicator">
            <doc>Simulation indicator (third extent)</doc>
          </field>
          <field name="localCtrl2" type="Cat253LocalCtrl">
            <doc>Local control (third extent)</doc>
          </field>
          <field name="dataIncluded2" type="Cat253DataIncl">
            <doc>Data included (third extent)</doc>
          </field>
          <reserved bits="3"/>
          <fx>
            <field name="startIndex3" type="uint16">
              <doc>Start Index (fourth extent)</doc>
            </field>
            <field name="count3" type="uint8">
              <doc>Number of data items (fourth extent)</doc>
            </field>
            <field name="stale3" type="Cat253StaleInd">
              <doc>Stale indicator (fourth extent)</doc>
            </field>
            <field name="sim3" type="SimIndicator">
              <doc>Simulation indicator (fourth extent)</doc>
            </field>
            <field name="localCtrl3" type="Cat253LocalCtrl">
              <doc>Local control (fourth extent)</doc>
            </field>
            <field name="dataIncluded3" type="Cat253DataIncl">
              <doc>Data included (fourth extent)</doc>
            </field>
            <reserved bits="3"/>
          </fx>
        </fx>
      </fx>
    </struct>

    <!-- =======================================================================
         I253/090 - Application Data
         Repetitive: REP(8) + N * data(128 bits = 16 bytes)
         Included but not used.
         ======================================================================= -->
    <struct name="Cat253I090">
      <doc>I253/090 - Application Data (not used, included for completeness)</doc>
      <field name="rep" type="uint8" auto="count(dataItems)">
        <doc>Repetition factor</doc>
      </field>
      <array name="dataItems" count-from="rep">
        <field name="data" bytes="16">
          <doc>Application data (16 bytes per item)</doc>
        </field>
      </array>
    </struct>

    <!-- ===================================================================
         I100 Variant Structs (standalone, decoded by application)
         Dispatch by I080 start-index: 0x0005=Multipath, 0x0006=Squitter, 0x0023=BitReport
         =================================================================== -->

    <!-- =======================================================================
         Cat253Multipath - I100 variant: Multipath data
         1 data byte (UZUNLUK/length byte not included):
           detection(4 enum) + level(4 enum)
         ======================================================================= -->
    <struct name="Cat253Multipath">
      <doc>I253/100 variant: Multipath data (1 data byte, excluding length)</doc>
      <field name="detection" type="Cat253MpDetection">
        <doc>Multipath detection: 0 = Disabled, 1 = Enabled</doc>
      </field>
      <field name="level" type="Cat253MpLevel">
        <doc>Multipath level (LSB = 1 dB, range 0-6 dB)</doc>
      </field>
    </struct>

    <!-- =======================================================================
         Cat253Squitter - I100 variant: Squitter data
         1 data byte (UZUNLUK/length byte not included):
           rx-channel(4 enum) + spare(2) + ms-squitter(1 enum) + m5-squitter(1 enum)
         ======================================================================= -->
    <struct name="Cat253Squitter">
      <doc>I253/100 variant: Squitter data (1 data byte, excluding length)</doc>
      <field name="rxChannel" type="Cat253SqRxChannel">
        <doc>Squitter receiving channel: 0 = SUM, 1 = DIFF, 2 = SUM+DIFF</doc>
      </field>
      <reserved bits="2"/>
      <field name="msSquitter" type="Cat253SqMsSquitter">
        <doc>Mode S Squitter</doc>
      </field>
      <field name="m5Squitter" type="Cat253SqM5Squitter">
        <doc>Mode 5 Squitter</doc>
      </field>
    </struct>

    <!-- =======================================================================
         Cat253BitReport - I100 variant: BIT Report data
         16 data bytes (UZUNLUK/length byte not included):

         Octet 1 (of data): bit-type(4) + success-state(4)
         Octet 2: antenna-general(4) + antenna-scan-error(4)
         Octet 3: reserved(4) + power-source-general(4)
         Octet 4: ctrl-unit-general(2) + kb-crypto-comm(2) + kb-rtc(2) + kb-heat-warning(2)
         Octet 5: bottom-band-general(4) + tb-ctrl-comm(2) + tb-config-upload(2)
         Octet 6: vswr-general(2) + vswr-sum(2) + vswr-diff(2) + vswr-omni(2)
         Octet 7: reserved(2) + afb-general(4) + afb-main-synth(2)
         Octet 8: afb-bit-synth(2) + afb-total-ch(2) + afb-diff-ch(2) + afb-omni-ch(2)
         Octet 9: rfgyb-general(4) + rfgyb-total-pwr(2) + rfgyb-diff-pwr(2)
         Octet 10: rfgyb-omni-pwr(2) + rfgyb-heat-warning(2) + crypto-general(4)
         Octets 11-16: reserved(8) x 6
         ======================================================================= -->
    <struct name="Cat253BitReport">
      <doc>I253/100 variant: BIT Report data (16 data bytes, excluding length)</doc>

      <!-- Octet 1 -->
      <field name="bitType" type="Cat253BrBitType">
        <doc>BIT Type</doc>
      </field>
      <field name="successState" type="Cat253BrSuccessState">
        <doc>Success State</doc>
      </field>

      <!-- Octet 2 -->
      <field name="antennaGeneral" type="Cat253BrAntennaGeneral">
        <doc>Antenna General Response</doc>
      </field>
      <field name="antennaScanError" type="Cat253BrAntennaScanError">
        <doc>Antenna Scan Error</doc>
      </field>

      <!-- Octet 3 -->
      <reserved bits="4"/>
      <field name="powerSourceGeneral" type="Cat253BrPowerSourceGeneral">
        <doc>Power Source General</doc>
      </field>

      <!-- Octet 4 -->
      <field name="ctrlUnitGeneral" type="Cat253BrCtrlUnitGeneral">
        <doc>Control Unit General</doc>
      </field>
      <field name="kbCryptoComm" type="Cat253BrKbCryptoComm">
        <doc>KB Crypto Communication</doc>
      </field>
      <field name="kbRtc" type="Cat253BrKbRtc">
        <doc>KB RTC</doc>
      </field>
