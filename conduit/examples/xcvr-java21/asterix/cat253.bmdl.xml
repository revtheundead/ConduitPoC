  <messages>
    <!-- =======================================================================
         CAT253 Record
         FSPEC bitmap with 2 FSPEC octets (14 FRN positions)
         Proposed Standard UAP
         ======================================================================= -->
    <message id="253" name="Cat253Record">
      <doc>
        CAT253 Record (Remote Monitoring and Control, Issue 9.0)
        Proposed Standard UAP with 2 FSPEC octets, 12 data items + SP + RFS.
      </doc>

      <struct name="items" presence="bitmap">
        <bitmap ext="7"/>

        <!-- FSPEC Octet 1 (FRN 1-7) -->

        <!-- FRN 1: I253/010 - Data Source Identifier (2 octets) -->
        <field name="i010" bit="0" type="DataSourceId">
          <doc>I253/010 - Data Source Identifier (SAC/SIC)</doc>
        </field>

        <!-- FRN 2: I253/015 - Local Data Source Identifier (1 octet) -->
        <field name="i015" bit="1" type="uint8">
          <doc>I253/015 - Local Data Source Identifier</doc>
        </field>

        <!-- FRN 3: I253/025 - Data Destination Identifier (1 + 3*N octets) -->
        <field name="i025" bit="2" type="Cat253I025">
          <doc>I253/025 - Data Destination Identifier and Local Data Destination ID</doc>
        </field>

        <!-- FRN 4: I253/030 - Source Application Identifier (2 octets) -->
        <field name="i030" bit="3" type="uint16">
          <doc>I253/030 - Source Application Identifier</doc>
        </field>

        <!-- FRN 5: I253/040 - Message Type Identifier (1 octet) -->
        <field name="i040" bit="4" type="Cat253I040">
          <doc>I253/040 - Message Type Identifier</doc>
        </field>

        <!-- FRN 6: I253/050 - Message Sequence Identifier (1 + 2*N octets) -->
        <field name="i050" bit="5" type="Cat253I050">
          <doc>I253/050 - Message Sequence Identifier</doc>
        </field>

        <!-- FRN 7: I253/070 - Time of Day (3 octets) -->
        <field name="i070" bit="6" type="TimeOfDay">
          <doc>I253/070 - Time of Day</doc>
        </field>

        <!-- FSPEC Octet 2 (FRN 8-14) -->

        <!-- FRN 8: I253/035 - Data Origin Identifier (3 octets) -->
        <field name="i035" bit="8" type="Cat253I035">
          <doc>I253/035 - Data Origin Identifier</doc>
        </field>

        <!-- FRN 9: I253/060 - Blocking Information (2 octets) -->
        <field name="i060" bit="9" type="Cat253I060">
          <doc>I253/060 - Blocking Information</doc>
        </field>

        <!-- FRN 10: I253/080 - Application Data Structure (4+ octets, FX chain) -->
        <field name="i080" bit="10" type="Cat253I080">
          <doc>I253/080 - Application Data Structure</doc>
        </field>

        <!-- FRN 11: I253/090 - Application Data (1 + 16*N octets, repetitive) -->
        <field name="i090" bit="11" type="Cat253I090">
          <doc>I253/090 - Application Data (not used)</doc>
        </field>

        <!-- FRN 12: I253/100 - Transparent Application Data 1 -->
        <!-- Dispatch by I080 start-index: 5=Multipath, 6=Squitter, 35=BitReport -->
        <struct name="i100" bit="12">
          <doc>I253/100 - Transparent Application Data 1</doc>
          <field name="len" type="uint8" auto="length">
              <doc>Length of I100 including this length byte</doc>
          </field>
          <choice name="payload" switch="i080.startIndex">
            <case name="multipath" value="0x05" type="Cat253Multipath"/>
            <case name="squitter" value="0x06" type="Cat253Squitter"/>
            <case name="bitReport" value="0x23" type="Cat253BitReport"/>
            <otherwise name="unknown">
              <field name="data" type="bytes" length-from="len - 1"/>
            </otherwise>
          </choice>
        </struct>

        <!-- FRN 13: SP - Special Purpose Field -->
        <struct name="sp" bit="13">
          <doc>Special Purpose Field</doc>
          <field name="len" type="uint8" auto="length">
            <doc>Length of SP including this length byte</doc>
          </field>
          <field name="data" type="bytes" length-from="len - 1"/>
        </struct>

        <!-- FRN 14: RFS - Random Field Sequencing -->
        <struct name="rfs" bit="14">
          <doc>Random Field Sequencing</doc>
          <field name="len" type="uint8" auto="length">
            <doc>Length of RFS including this length byte</doc>
          </field>
          <field name="data" type="bytes" length-from="len - 1"/>
        </struct>

      </struct>
    </message>
  </messages>

