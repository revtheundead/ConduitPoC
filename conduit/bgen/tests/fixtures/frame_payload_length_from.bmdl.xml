<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>frame_payload_length_from</namespace>
    <endian>big</endian>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>

  <frame name="ExprFrame">
    <field name="msg-type" type="uint8" auto="id"/>
    <field name="body-size" type="uint16"/>
    <payload length-from="body-size"/>
  </frame>

  <messages>
    <message id="1" name="Ping">
      <field name="seq" type="uint16"/>
    </message>
    <message id="2" name="Data">
      <field name="x" type="uint8"/>
      <field name="y" type="uint8"/>
      <field name="z" type="uint8"/>
    </message>
  </messages>
</bmdl>
