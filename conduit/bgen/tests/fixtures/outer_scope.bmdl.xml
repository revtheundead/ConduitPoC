<bmdl version="2.0">
  <defaults>
    <namespace>outer_scope</namespace>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>

    <!-- Simple payloads referenced by type in the choice -->
    <struct name="DataA">
      <field name="x" type="uint8"/>
      <field name="y" type="uint8"/>
    </struct>

    <struct name="DataB">
      <field name="value" type="uint16"/>
    </struct>

    <!--
      Tests:
        1. auto="length" backpatch on a struct field
        2. Outer-scope field access: otherwise case references parent's "len"
    -->
    <struct name="Packet">
      <field name="tag" type="uint8"/>
      <field name="len" type="uint8" auto="length"/>
      <choice name="payload" switch="tag">
        <case name="a" value="1" type="DataA"/>
        <case name="b" value="2" type="DataB"/>
        <otherwise name="raw">
          <field name="data" type="bytes" length-from="len - 2"/>
        </otherwise>
      </choice>
    </struct>
  </types>
</bmdl>
