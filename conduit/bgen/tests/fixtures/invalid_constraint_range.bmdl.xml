<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>invalid_constraint_range</namespace>
  </defaults>
  <types>
    <type name="uint4" base="uint" bits="4"/>
  </types>

  <messages>
    <message name="BadMessage">
      <!-- 1000 exceeds 4-bit unsigned range [0, 15] -->
      <field name="value" type="uint4">
        <constraint equals="1000"/>
      </field>
    </message>
  </messages>
</bmdl>
