<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>annotation_scope</namespace>
    <endian>big</endian>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="annotated-type" base="uint" bits="16">
      <annotation name="type-level" value="should-not-propagate"/>
    </type>
  </types>

  <frame name="Frame">
    <field name="msg-type" type="uint8" auto="id"/>
    <field name="length" type="uint16" auto="length"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="MsgWithAnnotations">
      <annotation name="msg-ann" value="propagated"/>
      <field name="value" type="annotated-type"/>
    </message>
    <message id="2" name="MsgNoAnnotations">
      <field name="data" type="uint16"/>
    </message>
  </messages>
</bmdl>
