<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults><namespace>hex_default</namespace></defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>

  <messages>
    <message name="HexMsg">
      <!-- M5: hex default values should be accepted -->
      <field name="header" type="uint8" default="0xFF"/>
      <field name="magic" type="uint16" default="0xBEEF"/>
      <field name="data" type="uint8"/>
    </message>
  </messages>
</bmdl>
