<bmdl version="1.0">
<protocol name="forward-ref" version="1.0">
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>
  <messages>
    <message name="Msg">
      <field name="a" type="uint16" present-when="b != 0"/>
      <field name="b" type="uint8"/>
    </message>
  </messages>
</protocol>
</bmdl>
