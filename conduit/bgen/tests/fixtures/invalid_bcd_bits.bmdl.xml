<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="1.0">
<protocol name="invalid-bcd-bits" version="1.0">
  <types>
    <!-- BCD requires bits divisible by 4; 10 is not -->
    <type name="bad-bcd" base="uint" bits="10" wire-encoding="bcd"/>
  </types>
  <messages>
    <message name="Msg">
      <field name="val" type="bad-bcd"/>
    </message>
  </messages>
</protocol>
</bmdl>
