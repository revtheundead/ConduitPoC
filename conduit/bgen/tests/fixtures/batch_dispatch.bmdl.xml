<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="1.0">
<protocol name="batch-test" version="1.0">

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>

    <type name="msg-type" base="uint" bits="8">
      <enum>
        <value id="1" name="records"/>
        <value id="2" name="events"/>
      </enum>
    </type>

    <!-- Simple record: 6 bytes -->
    <struct name="Record">
      <field name="id" type="uint16"/>
      <field name="value" type="uint32"/>
    </struct>

    <!-- Simple event: 1 byte -->
    <struct name="Event">
      <field name="code" type="uint8"/>
    </struct>
  </types>

  <messages>
    <!-- Container with msg-type discriminated choice -->
    <message name="Container">
      <field name="msg-type" type="msg-type"/>
      <field name="len" type="uint16"/>

      <choice name="body" switch="msg-type" length-from="len - 3">
        <!-- Batch (default): case wrapper type is the leaf -->
        <case name="records" value="1">
          <array name="items" count="*" type="Record"/>
        </case>
        <!-- Per-record: individual elements are the leaves -->
        <case name="events" value="2">
          <array name="items" count="*" type="Event" dispatch="per-record"/>
        </case>
      </choice>
    </message>

    <!-- Entry point: array of containers -->
    <message name="Frame" role="entry-point">
      <array name="containers" count="*" type="Container"/>
    </message>
  </messages>

</protocol>
</bmdl>
