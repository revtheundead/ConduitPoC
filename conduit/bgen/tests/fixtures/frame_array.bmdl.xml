<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <endian>big</endian>
    <namespace>frame_array</namespace>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>

  <frame name="ArrayFrame">
    <field name="msg-type" type="uint8" auto="id"/>
    <field name="length" type="uint16" auto="length"/>
    <payload count="*"/>
  </frame>

  <messages>
    <message id="1" name="Record">
      <field name="key" type="uint8"/>
      <field name="value" type="uint16"/>
    </message>
  </messages>
</bmdl>
