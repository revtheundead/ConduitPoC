<bmdl version="2.0">
  <defaults>
    <namespace>invalid_auto_count_max</namespace>
  </defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>
  <messages>
    <message name="Msg">
      <!-- auto="count" + constraint max should be rejected -->
      <field name="count" type="uint8" auto="count(items)">
        <constraint max="100"/>
      </field>
      <array name="items" type="uint16" length-from="count"/>
    </message>
  </messages>
</bmdl>
