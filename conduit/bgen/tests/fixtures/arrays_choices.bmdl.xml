<bmdl version="2.0">
  <defaults>
    <namespace>arrays_choices</namespace>
  </defaults>

  <constants>
    <const name="TYPE_A" type="uint8" value="1"/>
    <const name="TYPE_B" type="uint8" value="2"/>
    <const name="SUB_X" type="uint8" value="10"/>
    <const name="SUB_Y" type="uint8" value="20"/>
  </constants>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
    <struct name="Point">
      <field name="x" type="uint16"/>
      <field name="y" type="uint16"/>
    </struct>
    <struct name="SubX">
      <field name="val" type="uint32"/>
    </struct>
    <struct name="SubY">
      <field name="a" type="uint16"/>
      <field name="b" type="uint16"/>
    </struct>
    <struct name="TypeABody">
      <field name="sub-type" type="uint8"/>
      <choice name="sub-body" switch="sub-type">
        <case name="x" value="SUB_X" type="SubX"/>
        <case name="y" value="SUB_Y" type="SubY"/>
      </choice>
    </struct>
    <struct name="TypeBBody">
      <field name="tag" type="uint32"/>
    </struct>
    <struct name="FallbackBody">
      <field name="raw" type="uint32"/>
    </struct>
  </types>
  <messages>
    <message name="FixedArrayMsg">
      <array name="points" type="Point" count="3"/>
    </message>
    <message name="CountFromArrayMsg">
      <field name="num-items" type="uint8"/>
      <array name="items" type="Point" count-from="num-items"/>
    </message>
    <message name="ChoiceMsg">
      <field name="msg-type" type="uint8"/>
      <field name="length" type="uint16"/>
      <choice name="body" switch="msg-type" length-from="length">
        <case name="a" value="TYPE_A" type="TypeABody"/>
        <case name="b" value="TYPE_B" type="TypeBBody" direction="receive"/>
        <otherwise name="fallback" type="FallbackBody"/>
      </choice>
    </message>
    <!-- Nested choice: inner choice switch references field from message scope (outer scope) -->
    <message name="NestedChoiceMsg">
      <field name="msg-type" type="uint8"/>
      <field name="sub-type" type="uint8"/>
      <choice name="body" switch="msg-type">
        <case name="typed" value="1">
          <!-- inner choice switches on sub-type, which lives in message scope -->
          <choice name="detail" switch="sub-type">
            <case name="alpha" value="SUB_X">
              <field name="a-val" type="uint16"/>
            </case>
            <case name="beta" value="SUB_Y">
              <field name="b-val" type="uint32"/>
            </case>
          </choice>
        </case>
        <case name="simple" value="2">
          <field name="data" type="uint32"/>
        </case>
      </choice>
    </message>

    <!-- Deep nested choice: 3 levels, each switching on a different message-scope field -->
    <message name="DeepNestedMsg">
      <field name="type-a" type="uint8"/>
      <field name="type-b" type="uint8"/>
      <field name="type-c" type="uint8"/>
      <choice name="outer" switch="type-a">
        <case name="l1" value="1">
          <choice name="mid" switch="type-b">
            <case name="l2" value="SUB_X">
              <choice name="inner" switch="type-c">
                <case name="l3" value="SUB_Y">
                  <field name="value" type="uint32"/>
                </case>
              </choice>
            </case>
          </choice>
        </case>
      </choice>
    </message>
  </messages>
</bmdl>
