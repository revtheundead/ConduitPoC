<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>frame_payload_length</namespace>
    <endian>big</endian>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>

  <frame name="PayloadFrame">
    <field name="msg-type" type="uint8" auto="id"/>
    <field name="payload-len" type="uint16" auto="length(payload)"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="SimpleData">
      <field name="a" type="uint8"/>
      <field name="b" type="uint16"/>
    </message>
    <message id="2" name="LargeData">
      <field name="x" type="uint16"/>
      <field name="y" type="uint16"/>
      <field name="z" type="uint16"/>
    </message>
  </messages>
</bmdl>
