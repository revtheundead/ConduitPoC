<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>invalid_bcd_signed</namespace>
  </defaults>
  <types>
    <!-- BCD requires base='uint', not 'int' -->
    <type name="bad-bcd" base="int" bits="16" wire-encoding="bcd"/>
  </types>
  <messages>
    <message name="Msg">
      <field name="val" type="bad-bcd"/>
    </message>
  </messages>
</bmdl>
