<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>invalid_constant_range</namespace>
  </defaults>
  <types>
    <type name="uint4" base="uint" bits="4"/>
  </types>

  <constants>
    <!-- 999 exceeds 4-bit unsigned range [0, 15] -->
    <const name="TooBig" type="uint4" value="999"/>
  </constants>

  <messages>
    <message name="Msg">
      <field name="value" type="uint4"/>
    </message>
  </messages>
</bmdl>
