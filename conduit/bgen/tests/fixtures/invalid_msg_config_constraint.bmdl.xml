<bmdl version="2.0">
  <defaults>
    <namespace>invalid_msg_config_constraint</namespace>
  </defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>

  <frame name="Frame">
    <field name="msg-type" type="uint8" auto="id"/>
    <field name="length" type="uint16" auto="length"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="Msg">
      <!-- auto="config" + constraint should be rejected on message fields too -->
      <field name="sysid" type="uint8" auto="config(sysid)">
        <constraint equals="42"/>
      </field>
      <field name="data" type="uint8"/>
    </message>
  </messages>
</bmdl>
