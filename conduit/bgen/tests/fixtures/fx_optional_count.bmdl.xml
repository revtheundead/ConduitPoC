<?xml version="1.0" encoding="UTF-8"?>
<!-- Issue 2 regression: an array whose count-from references an optional field
     declared in the same FX extent. The generated code must dereference the
     optional (e.g. *(result.rep_)) before casting it to a count, otherwise the
     C++ build breaks on static_cast of a std::optional. -->
<bmdl version="2.0">
  <defaults>
    <namespace>fx_optional_count</namespace>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
  </types>

  <messages>
    <message name="RepMsg">
      <field name="header" type="uint8"/>
      <fx>
        <!-- optional field inside the FX extent -->
        <field name="rep" type="uint8"/>
        <!-- count references the optional field in the same extent -->
        <array name="items" type="uint8" count-from="rep"/>
      </fx>
    </message>
  </messages>
</bmdl>
