<bmdl version="2.0">
  <defaults>
    <namespace>resolve_scale_conflict</namespace>
  </defaults>
  <types>
    <type name="uint16" base="uint" bits="16">
      <scale>0.1</scale>
      <offset>-10</offset>
    </type>
  </types>
