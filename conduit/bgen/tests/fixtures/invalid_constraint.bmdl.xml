<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="1.0">
<protocol name="invalid-constraint" version="1.0">

  <types>
    <type name="uint8" base="uint" bits="8"/>
  </types>

  <messages>
    <message name="BadMessage">
      <field name="value" type="uint8">
        <!-- equals and min/max are mutually exclusive -->
        <constraint equals="42" min="10"/>
      </field>
    </message>
  </messages>

</protocol>
</bmdl>
