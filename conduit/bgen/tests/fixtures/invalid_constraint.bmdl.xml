<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>invalid_constraint</namespace>
  </defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
  </types>

  <messages>
    <message name="BadMessage">
      <field name="value" type="uint8">
