<bmdl version="2.0">
  <defaults>
    <namespace>invalid_remaining</namespace>
  </defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <struct name="Inner">
      <!-- length="*" outside bounded container should be rejected -->
      <field name="data" type="uint8" length="*"/>
    </struct>
  </types>
  <messages>
    <message name="Msg">
      <field name="header" type="uint16"/>
      <field name="inner" type="Inner"/>
    </message>
  </messages>
</bmdl>
