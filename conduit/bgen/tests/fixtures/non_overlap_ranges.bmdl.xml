<bmdl version="2.0">
  <defaults>
    <namespace>non_overlap_ranges</namespace>
  </defaults>
  <constants>
    <const name="LO_A" type="uint8" value="1"/>
    <const name="HI_A" type="uint8" value="5"/>
    <const name="LO_B" type="uint8" value="6"/>
    <const name="HI_B" type="uint8" value="10"/>
  </constants>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <struct name="BodyA"><field name="x" type="uint16"/></struct>
    <struct name="BodyB"><field name="y" type="uint16"/></struct>
  </types>
  <messages>
    <message name="Msg">
      <field name="tag" type="uint8"/>
      <choice name="body" switch="tag">
        <case name="a" range="LO_A..HI_A" type="BodyA"/>
        <case name="b" range="LO_B..HI_B" type="BodyB"/>
      </choice>
    </message>
  </messages>
</bmdl>
