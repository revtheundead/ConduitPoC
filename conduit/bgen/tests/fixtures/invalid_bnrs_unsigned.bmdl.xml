<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>invalid_bnrs_unsigned</namespace>
  </defaults>
  <types>
    <!-- BNR_S requires base='int', not 'uint' -->
    <type name="bad-bnrs" base="uint" bits="16" wire-encoding="bnr-s"/>
  </types>
  <messages>
    <message name="Msg">
      <field name="val" type="bad-bnrs"/>
    </message>
  </messages>
</bmdl>
