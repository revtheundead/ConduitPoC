<bmdl version="1.0">
<protocol name="invalid-auto-type" version="1.0">
  <types>
    <type name="uint8" base="uint" bits="8"/>
  </types>
  <messages>
    <message name="BadMsg">
      <!-- auto must be "increment", not arbitrary string -->
      <field name="counter" type="uint8" auto="decrement"/>
    </message>
  </messages>
</protocol>
</bmdl>
