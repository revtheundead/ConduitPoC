<bmdl version="2.0">
  <defaults>
    <namespace>send_only</namespace>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>

  <frame name="Frame">
    <field name="tag" type="uint8" auto="id"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="SendBody" direction="send">
      <field name="x" type="uint16"/>
    </message>
    <message id="2" name="RecvBody" direction="receive">
      <field name="y" type="uint16"/>
    </message>
  </messages>
</bmdl>
