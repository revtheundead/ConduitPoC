<bmdl version="1.0">
<protocol name="send-only" version="1.0">
  <constants>
    <const name="TYPE_A" type="uint8" value="1"/>
    <const name="TYPE_B" type="uint8" value="2"/>
  </constants>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <struct name="SendBody"><field name="x" type="uint16"/></struct>
    <struct name="RecvBody"><field name="y" type="uint16"/></struct>
  </types>
  <messages>
    <message name="Frame" role="entry-point">
      <field name="tag" type="uint8"/>
      <choice name="body" switch="tag">
        <case name="send" value="TYPE_A" type="SendBody" direction="send"/>
        <case name="recv" value="TYPE_B" type="RecvBody" direction="receive"/>
      </choice>
    </message>
  </messages>
</protocol>
</bmdl>
