<bmdl version="2.0">
  <!-- Library file: no <protocol>, just shared types and constants -->
  <constants>
    <const name="LIB_VERSION" type="uint8" value="42"/>
    <const name="MAX_SIZE" type="uint16" value="1024"/>
  </constants>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
    <struct name="SharedHeader">
      <field name="id" type="uint16"/>
      <field name="flags" type="uint8"/>
    </struct>
  </types>
</bmdl>
