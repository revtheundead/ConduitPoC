<bmdl version="1.0">
<protocol name="invalid-inline-dup" version="1.0">
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <struct name="Header">
      <field name="x" type="uint16"/>
      <field name="y" type="uint16"/>
    </struct>
  </types>
  <messages>
    <message name="Msg">
      <!-- Field "x" already exists, inline introduces duplicate -->
      <field name="x" type="uint8"/>
      <field name="hdr" type="Header" inline="true"/>
    </message>
  </messages>
</protocol>
</bmdl>
