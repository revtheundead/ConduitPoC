<bmdl version="2.0">
  <defaults>
    <namespace>session_test</namespace>
  </defaults>

  <constants>
    <const name="SYNC" type="uint16" value="0xDEAD"/>
  </constants>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
  </types>

  <frame name="Packet">
    <field name="sync" type="uint16"><constraint equals="SYNC"/></field>
    <field name="seq" type="uint16" auto="increment"/>
    <field name="msg-id" type="uint8" auto="id"/>
    <field name="length" type="uint16" auto="length"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="PingBody">
      <field name="timestamp" type="uint32"/>
    </message>
    <message id="2" name="DataBody">
      <field name="channel" type="uint8"/>
      <field name="payload-a" type="uint32"/>
      <field name="payload-b" type="uint32"/>
    </message>
    <message id="3" name="AckBody" direction="receive">
      <field name="acked-seq" type="uint16"/>
    </message>
  </messages>
</bmdl>
