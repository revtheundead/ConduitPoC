<bmdl version="2.0">
  <defaults>
    <namespace>signed_length</namespace>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="int16" base="int" bits="16"/>
  </types>

  <frame name="SignedFrame">
    <field name="msg-type" type="uint8" auto="id"/>
    <field name="length" type="int16" auto="length"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="Payload">
      <field name="value" type="uint16"/>
    </message>
  </messages>
</bmdl>
