<bmdl version="2.0">
  <defaults>
    <namespace>invalid_constraint_type_mismatch</namespace>
  </defaults>
  <constants>
    <const name="STR_CONST" type="label-str" value="hello"/>
  </constants>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="label-str" base="string" length="8"/>
  </types>
  <messages>
    <message name="Msg">
      <!-- uint field with constraint referencing a string-typed constant -->
      <field name="code" type="uint8">
        <constraint equals="STR_CONST"/>
      </field>
    </message>
  </messages>
</bmdl>
