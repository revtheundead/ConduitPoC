<?xml version="1.0" encoding="UTF-8"?>
<!--
  Invalid fixture: dispatch attribute on an array outside a choice case.
  The validator should reject this because dispatch is only valid on arrays
  that are direct children of inline choice cases.
-->
<bmdl version="1.0">
<protocol name="dispatch-context-test" version="1.0">

  <types>
    <type name="uint8" base="uint" bits="8"/>

    <struct name="Record">
      <field name="id" type="uint8"/>
    </struct>
  </types>

  <messages>
    <!-- dispatch on a top-level message array — should be rejected -->
    <message name="Frame">
      <array name="items" count="*" type="Record" dispatch="per-record"/>
    </message>
  </messages>

</protocol>
</bmdl>
