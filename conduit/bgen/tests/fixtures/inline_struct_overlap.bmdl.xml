<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>inline_struct_overlap</namespace>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
  </types>

  <messages>
    <!-- Two messages both define inline structs named "items" with different fields.
         Without parent-prefixed naming, the second Items class overwrites the first. -->

    <message name="MsgFoo">
      <field name="count" type="uint8"/>
      <struct name="items">
        <field name="foo-x" type="uint32"/>
        <field name="foo-y" type="uint16"/>
      </struct>
    </message>

    <message name="MsgBar">
      <field name="count" type="uint8"/>
      <struct name="items">
        <field name="bar-a" type="uint8"/>
        <field name="bar-b" type="uint8"/>
        <field name="bar-c" type="uint8"/>
      </struct>
    </message>

    <!-- Also test inline array elements with the same name across messages -->

    <message name="MsgAlpha">
      <field name="tag" type="uint8"/>
      <array name="entries" count="2">
        <field name="alpha-val" type="uint32"/>
      </array>
    </message>

    <message name="MsgBeta">
      <field name="tag" type="uint8"/>
      <array name="entries" count="3">
        <field name="beta-val" type="uint16"/>
      </array>
    </message>
  </messages>
</bmdl>
