<bmdl version="2.0">
  <defaults>
    <namespace>invalid_shift_overflow</namespace>
  </defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>
  <messages>
    <message name="Msg">
      <field name="len" type="uint16"/>
      <field name="data" type="uint8" length-from="len &lt;&lt; 65"/>
    </message>
  </messages>
</bmdl>
