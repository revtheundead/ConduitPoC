<bmdl version="2.0">
  <defaults>
    <namespace>constraints</namespace>
    <endian>big</endian>
  </defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
    <type name="int16" base="int" bits="16"/>
  </types>
  <messages>
    <message name="ConstraintMsg">
      <!-- Field with equals constraint -->
      <field name="magic" type="uint16">
        <constraint equals="0xBEEF"/>
      </field>
      <!-- Field with range constraint -->
      <field name="percent" type="uint8">
        <constraint min="0" max="100"/>
      </field>
      <!-- Field with deferred constraint -->
      <field name="deferred-val" type="uint16">
        <constraint min="10" max="500" validate="deferred"/>
      </field>
      <!-- Regular field -->
      <field name="payload" type="uint32"/>
    </message>
  </messages>
</bmdl>
