<bmdl version="2.0">
  <defaults>
    <namespace>invalid_auto_length_min</namespace>
  </defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>
  <messages>
    <message name="Msg">
      <!-- auto="length" + constraint min should be rejected -->
      <field name="len" type="uint16" auto="length">
        <constraint min="3"/>
      </field>
      <field name="data" type="uint8"/>
    </message>
  </messages>
</bmdl>
