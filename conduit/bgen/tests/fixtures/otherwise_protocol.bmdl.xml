<bmdl version="1.0">
<protocol name="otherwise-test" version="1.0">
  <constants>
    <const name="TYPE_A" type="uint8" value="1"/>
  </constants>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <struct name="BodyA"><field name="x" type="uint16"/></struct>
    <struct name="FallbackBody"><field name="y" type="uint16"/></struct>
  </types>
  <messages>
    <message name="Frame" role="entry-point">
      <field name="tag" type="uint8"/>
      <choice name="body" switch="tag">
        <case name="a" value="TYPE_A" type="BodyA"/>
        <otherwise name="fallback" type="FallbackBody"/>
      </choice>
    </message>
  </messages>
</protocol>
</bmdl>
