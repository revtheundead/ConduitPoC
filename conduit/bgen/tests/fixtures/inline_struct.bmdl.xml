<bmdl version="2.0">
  <defaults>
    <namespace>inline_struct</namespace>
  </defaults>

  <constants>
    <const name="SYNC" type="uint16" value="0xCAFE"/>
  </constants>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
  </types>

  <frame name="Frame">
    <field name="sync" type="uint16"><constraint equals="SYNC"/></field>
    <field name="seq" type="uint16" auto="increment"/>
    <field name="length" type="uint16" auto="length"/>
    <field name="msg-type" type="uint8" auto="id"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="BodyX">
      <field name="x-data" type="uint32"/>
    </message>
    <message id="2" name="BodyY">
      <field name="y-data" type="uint16"/>
    </message>
  </messages>
</bmdl>
