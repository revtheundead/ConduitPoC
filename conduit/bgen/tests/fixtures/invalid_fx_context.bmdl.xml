<bmdl version="2.0">
  <defaults>
    <namespace>invalid_fx_context</namespace>
  </defaults>
  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>
  <messages>
    <message name="Msg">
      <field name="tag" type="uint8"/>
      <array name="items" count="3">
        <field name="val" type="uint16"/>
        <!-- FX inside array should be rejected -->
        <fx>
          <field name="ext" type="uint8"/>
        </fx>
      </array>
    </message>
  </messages>
</bmdl>
