<bmdl version="2.0">
  <defaults>
    <namespace>direction_qualified</namespace>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
  </types>

  <frame name="Frame">
    <field name="tag" type="uint8" auto="id"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="UplinkPayload" direction="send">
      <field name="tx-data" type="uint16"/>
    </message>
    <message id="1" name="DownlinkPayload" direction="receive">
      <field name="rx-data" type="uint32"/>
    </message>
    <message id="2" name="CommonPayload">
      <field name="common-data" type="uint8"/>
    </message>
  </messages>
</bmdl>
