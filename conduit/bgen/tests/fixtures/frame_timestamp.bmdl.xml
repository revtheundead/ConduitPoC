<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <endian>big</endian>
    <namespace>frame_timestamp</namespace>
  </defaults>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
  </types>

  <frame name="TsFrame">
    <field name="msg-type" type="uint8" auto="id"/>
    <field name="ts" type="uint32" auto="timestamp"/>
    <field name="length" type="uint16" auto="length"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="Ping">
      <field name="seq" type="uint16"/>
    </message>
  </messages>
</bmdl>
