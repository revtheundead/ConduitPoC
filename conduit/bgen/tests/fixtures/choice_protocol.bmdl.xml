<?xml version="1.0" encoding="UTF-8"?>
<bmdl version="2.0">
  <defaults>
    <namespace>choice_test</namespace>
  </defaults>

  <constants>
    <const name="SYNC" type="uint16" value="0xBEEF"/>
  </constants>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
    <type name="uint32" base="uint" bits="32"/>
  </types>

  <frame name="Frame">
    <field name="sync" type="uint16"><constraint equals="SYNC"/></field>
    <field name="message-type" type="uint8" auto="id"/>
    <field name="length" type="uint16" auto="length"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="AlphaBody">
      <annotation name="group" value="control"/>
      <field name="x" type="uint16"/>
      <field name="y" type="uint16"/>
    </message>
    <message id="2" name="BetaBody" direction="receive">
      <annotation name="group" value="data"/>
      <field name="payload-size" type="uint8"/>
      <field name="tag" type="uint32"/>
    </message>
  </messages>
</bmdl>
