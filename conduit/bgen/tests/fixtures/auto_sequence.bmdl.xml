<bmdl version="2.0">
  <defaults>
    <namespace>auto_seq</namespace>
  </defaults>

  <constants>
    <const name="SYNC" type="uint16" value="0xBEEF"/>
  </constants>

  <types>
    <type name="uint8" base="uint" bits="8"/>
    <type name="uint16" base="uint" bits="16"/>
  </types>

  <frame name="Frame">
    <field name="sync" type="uint16"><constraint equals="SYNC"/></field>
    <field name="seq" type="uint16" auto="increment"/>
    <field name="tag" type="uint8" auto="id"/>
    <payload/>
  </frame>

  <messages>
    <message id="1" name="BodyA">
      <field name="data" type="uint16"/>
    </message>
  </messages>
</bmdl>
