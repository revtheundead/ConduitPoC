<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.conduit</groupId>
    <artifactId>conduit-java</artifactId>
    <version>1.1.3</version>
    <packaging>jar</packaging>

    <name>Conduit Java Bindings</name>
    <description>Java bindings for the Conduit binary protocol library (JDK 11+ JNI / JDK 21+ Panama FFI)</description>
    <url>https://github.com/revtheundead/ConduitPoC</url>

    <licenses>
        <license>
            <name>MIT</name>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <!--
          Native libraries for the fat JAR are placed under
          src/main/resources/native/<os>-<arch>/ by the release workflow.
          During normal development builds this directory is empty/absent
          and the JAR contains only Java classes.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!--
              Default compilation: Java 11 target.
              Panama-specific files are EXCLUDED â€” they use java.lang.foreign
              which does not exist in Java 11. When building with JDK 21+, the
              "panama" profile adds a second compilation pass for those files.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>11</release>
                    <excludes>
                        <exclude>io/conduit/CabiBindings.java</exclude>
                        <exclude>io/conduit/CodecBindings.java</exclude>
                        <exclude>io/conduit/PanamaNativeBinding.java</exclude>
                        <exclude>io/conduit/PanamaCodecBinding.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Panama FFI profile: compile the Panama-specific classes (CabiBindings,
          CodecBindings, PanamaNativeBinding, PanamaCodecBinding) with Java 21.
          Automatically active when building with JDK 21+.
        -->
        <profile>
            <id>panama</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.13.0</version>
                        <executions>
                            <execution>
                                <id>compile-panama</id>
                                <phase>compile</phase>
                                <goals><goal>compile</goal></goals>
                                <configuration>
                                    <release>21</release>
                                    <compilerArgs>
                                        <arg>--enable-preview</arg>
                                    </compilerArgs>
                                    <!-- Clear inherited excludes so these files ARE compiled -->
                                    <excludes combine.self="override"/>
                                    <includes>
                                        <include>io/conduit/CabiBindings.java</include>
                                        <include>io/conduit/CodecBindings.java</include>
                                        <include>io/conduit/PanamaNativeBinding.java</include>
                                        <include>io/conduit/PanamaCodecBinding.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
