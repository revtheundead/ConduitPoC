    <type name="cat253-br-kb-crypto-comm" base="uint" bits="2">
      <doc>KB Crypto Communication</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-kb-rtc" base="uint" bits="2">
      <doc>KB RTC</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-kb-heat-warning" base="uint" bits="2">
      <doc>KB Heat Warning</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 6 -->
    <type name="cat253-br-bottom-band-general" base="uint" bits="4">
      <doc>General Bottom Band</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-tb-ctrl-comm" base="uint" bits="2">
      <doc>TB Control Unit Communication</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-tb-config-upload" base="uint" bits="2">
      <doc>TB Config Upload</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 7 -->
    <type name="cat253-br-vswr-general" base="uint" bits="2">
      <doc>VSWR General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-vswr-sum" base="uint" bits="2">
      <doc>VSWR Sum</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-vswr-diff" base="uint" bits="2">
      <doc>VSWR Difference</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-vswr-omni" base="uint" bits="2">
      <doc>VSWR Omni</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 8 -->
    <type name="cat253-br-afb-general" base="uint" bits="4">
      <doc>AFB General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-afb-main-synth" base="uint" bits="2">
      <doc>AFB Main Synthesizer</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 9 -->
    <type name="cat253-br-afb-bit-synth" base="uint" bits="2">
      <doc>AFB BIT Synthesizer</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-afb-total-ch" base="uint" bits="2">
      <doc>AFB Total Channel</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-afb-diff-ch" base="uint" bits="2">
      <doc>AFB Difference Channel</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
