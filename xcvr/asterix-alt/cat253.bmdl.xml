    <!-- Octet 10 -->
    <type name="cat253-br-rfgyb-general" base="uint" bits="4">
      <doc>RFGYB General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-rfgyb-total-pwr" base="uint" bits="2">
      <doc>RFGYB Total Output Power</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
