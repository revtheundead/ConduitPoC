    </type>

    <type name="cat253-br-rfgyb-diff-pwr" base="uint" bits="2">
      <doc>RFGYB Difference Output Power</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- Octet 11 -->
    <type name="cat253-br-rfgyb-omni-pwr" base="uint" bits="2">
      <doc>RFGYB Omni Output Power</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-rfgyb-heat-warning" base="uint" bits="2">
      <doc>RFGYB Heat Warning</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <type name="cat253-br-crypto-general" base="uint" bits="4">
      <doc>Crypto General</doc>
      <enum>
        <value id="0" name="ok"/>
        <value id="1" name="error"/>
        <value id="2" name="unknown"/>
      </enum>
    </type>

    <!-- ===================================================================
         Cat253-specific Binary Enum Types
         =================================================================== -->

    <!-- I253/040 Priority Indicator (1 bit) -->
    <type name="cat253-priority" base="uint" bits="1">
      <doc>Priority Indicator: 0 = Normal, 1 = High priority</doc>
      <enum>
        <value id="0" name="normal"/>
        <value id="1" name="high"/>
      </enum>
    </type>

    <!-- I253/040 Direction (1 bit) -->
    <type name="cat253-direction" base="uint" bits="1">
      <doc>Direction: 0 = Request, 1 = Response</doc>
      <enum>
        <value id="0" name="request"/>
        <value id="1" name="response"/>
      </enum>
    </type>

    <!-- I253/080 Stale Indicator (1 bit) -->
    <type name="cat253-stale-ind" base="uint" bits="1">
      <doc>Stale indicator: 0 = Current, 1 = Stale</doc>
      <enum>
        <value id="0" name="current"/>
        <value id="1" name="stale"/>
      </enum>
    </type>

    <!-- I253/080 Local Control (1 bit) -->
    <type name="cat253-local-ctrl" base="uint" bits="1">
      <doc>Local control: 0 = Not under local control, 1 = Under local control</doc>
      <enum>
        <value id="0" name="not-local"/>
        <value id="1" name="local"/>
      </enum>
    </type>

    <!-- I253/080 Data Included (1 bit) -->
    <type name="cat253-data-incl" base="uint" bits="1">
      <doc>Data included: 0 = No data in I100, 1 = Data included in I100</doc>
      <enum>
        <value id="0" name="no-data"/>
        <value id="1" name="data-included"/>
      </enum>
    </type>

    <!-- ===================================================================
         Data Item Structs
         =================================================================== -->

    <!-- =======================================================================
         I253/025 - Data Destination Identifier + Local ID
         Repetitive: REP(8) + N * (SAC(8) + SIC(8) + LocalId(8))
         ======================================================================= -->
    <struct name="Cat253I025">
      <doc>I253/025 - Data Destination Identifier and Local Data Destination ID</doc>
      <field name="rep" type="uint8" auto="count(destinations)">
        <doc>Repetition factor</doc>
      </field>
      <array name="destinations" count-from="rep">
        <field name="sac" type="uint8">
          <doc>System Area Code of destination</doc>
        </field>
        <field name="sic" type="uint8">
          <doc>System Identification Code of destination</doc>
        </field>
        <field name="local-id" type="uint8">
          <doc>Local Data Destination Identifier</doc>
        </field>
      </array>
    </struct>

    <!-- =======================================================================
         I253/035 - Data Origin Identifier
         Fixed 3 octets: OAC(8) + OIC(8) + LocalId(8)
         ======================================================================= -->
    <struct name="Cat253I035">
      <doc>I253/035 - Data Origin Identifier</doc>
      <field name="oac" type="uint8">
        <doc>Origin Area Code</doc>
      </field>
      <field name="oic" type="uint8">
        <doc>Origin Identification Code</doc>
      </field>
      <field name="local-id" type="uint8">
        <doc>Origin Local Identifier</doc>
      </field>
    </struct>

    <!-- =======================================================================
         I253/040 - Message Type Identifier
         Fixed 1 octet: PI(1) + D(1) + MIT(6 enum)
         ======================================================================= -->
    <struct name="Cat253I040">
      <doc>I253/040 - Message Type Identifier</doc>
      <field name="pi" type="cat253-priority">
        <doc>Priority indicator</doc>
      </field>
      <field name="d" type="cat253-direction">
        <doc>Direction</doc>
      </field>
      <field name="mit" type="cat253-msg-type">
        <doc>Message Type Identification</doc>
      </field>
    </struct>

    <!-- =======================================================================
         I253/050 - Message Sequence Identifier
         Repetitive: REP(8) + N * MSID(16)
         ======================================================================= -->
    <struct name="Cat253I050">
      <doc>I253/050 - Message Sequence Identifier</doc>
      <field name="rep" type="uint8" auto="count(sequences)">
        <doc>Repetition factor</doc>
      </field>
      <array name="sequences" count-from="rep">
        <field name="msid" type="uint16">
          <doc>Message Sequence Identifier</doc>
        </field>
      </array>
    </struct>

    <!-- =======================================================================
         I253/060 - Blocking Information
         Fixed 2 octets: TNB(8) + BN(8)
         ======================================================================= -->
    <struct name="Cat253I060">
      <doc>I253/060 - Blocking Information</doc>
      <field name="tnb" type="uint8">
        <doc>Total Number of Blocks</doc>
      </field>
      <field name="bn" type="uint8">
        <doc>Block Number</doc>
      </field>
    </struct>

    <!-- =======================================================================
         I253/080 - Application Data Structure
         Variable length (FX chain, 4 bytes per extent)
         Each extent: start-index(16) + count(8) + stale(1) + sim(1) +
                      local-ctrl(1) + data-included(1) + spare(3) + FX(1)
         Up to 4 nesting levels.
         ======================================================================= -->
    <struct name="Cat253I080">
      <doc>I253/080 - Application Data Structure</doc>
      <field name="start-index" type="uint16">
        <doc>Start Index (determines data structure in I100)</doc>
      </field>
      <field name="count" type="uint8">
        <doc>Number of data items</doc>
      </field>
      <field name="stale" type="cat253-stale-ind">
        <doc>Stale indicator</doc>
      </field>
      <field name="sim" type="sim-indicator">
        <doc>Simulation indicator</doc>
      </field>
      <field name="local-ctrl" type="cat253-local-ctrl">
        <doc>Local control</doc>
      </field>
      <field name="data-included" type="cat253-data-incl">
        <doc>Data included</doc>
      </field>
      <reserved bits="3"/>
      <fx>
        <field name="start-index1" type="uint16">
          <doc>Start Index (second extent)</doc>
        </field>
        <field name="count1" type="uint8">
          <doc>Number of data items (second extent)</doc>
        </field>
        <field name="stale1" type="cat253-stale-ind">
          <doc>Stale indicator (second extent)</doc>
        </field>
        <field name="sim1" type="sim-indicator">
          <doc>Simulation indicator (second extent)</doc>
        </field>
        <field name="local-ctrl1" type="cat253-local-ctrl">
          <doc>Local control (second extent)</doc>
        </field>
        <field name="data-included1" type="cat253-data-incl">
          <doc>Data included (second extent)</doc>
        </field>
        <reserved bits="3"/>
        <fx>
          <field name="start-index2" type="uint16">
            <doc>Start Index (third extent)</doc>
          </field>
          <field name="count2" type="uint8">
            <doc>Number of data items (third extent)</doc>
          </field>
          <field name="stale2" type="cat253-stale-ind">
            <doc>Stale indicator (third extent)</doc>
          </field>
          <field name="sim2" type="sim-indicator">
            <doc>Simulation indicator (third extent)</doc>
          </field>
          <field name="local-ctrl2" type="cat253-local-ctrl">
            <doc>Local control (third extent)</doc>
          </field>
          <field name="data-included2" type="cat253-data-incl">
            <doc>Data included (third extent)</doc>
          </field>
          <reserved bits="3"/>
          <fx>
            <field name="start-index3" type="uint16">
              <doc>Start Index (fourth extent)</doc>
            </field>
            <field name="count3" type="uint8">
              <doc>Number of data items (fourth extent)</doc>
            </field>
            <field name="stale3" type="cat253-stale-ind">
              <doc>Stale indicator (fourth extent)</doc>
            </field>
            <field name="sim3" type="sim-indicator">
              <doc>Simulation indicator (fourth extent)</doc>
            </field>
            <field name="local-ctrl3" type="cat253-local-ctrl">
              <doc>Local control (fourth extent)</doc>
            </field>
            <field name="data-included3" type="cat253-data-incl">
              <doc>Data included (fourth extent)</doc>
            </field>
            <reserved bits="3"/>
          </fx>
        </fx>
      </fx>
    </struct>

    <!-- =======================================================================
         I253/090 - Application Data
         Repetitive: REP(8) + N * data(128 bits = 16 bytes)
         Included but not used.
         ======================================================================= -->
    <struct name="Cat253I090">
      <doc>I253/090 - Application Data (not used, included for completeness)</doc>
      <field name="rep" type="uint8" auto="count(data-items)">
        <doc>Repetition factor</doc>
      </field>
      <array name="data-items" count-from="rep">
        <field name="data" bytes="16">
          <doc>Application data (16 bytes per item)</doc>
        </field>
      </array>
    </struct>

    <!-- ===================================================================
         I100 Variant Structs (standalone, decoded by application)
         Dispatch by I080 start-index: 0x0005=Multipath, 0x0006=Squitter, 0x0023=BitReport
         =================================================================== -->

    <!-- =======================================================================
         Cat253Multipath - I100 variant: Multipath data
         1 data byte (UZUNLUK/length byte not included):
           detection(4 enum) + level(4 enum)
         ======================================================================= -->
    <struct name="Cat253Multipath">
      <doc>I253/100 variant: Multipath data (1 data byte, excluding length)</doc>
      <field name="detection" type="cat253-mp-detection">
        <doc>Multipath detection: 0 = Disabled, 1 = Enabled</doc>
      </field>
      <field name="level" type="cat253-mp-level">
        <doc>Multipath level (LSB = 1 dB, range 0-6 dB)</doc>
      </field>
    </struct>

    <!-- =======================================================================
         Cat253Squitter - I100 variant: Squitter data
         1 data byte (UZUNLUK/length byte not included):
           rx-channel(4 enum) + spare(2) + ms-squitter(1 enum) + m5-squitter(1 enum)
         ======================================================================= -->
    <struct name="Cat253Squitter">
      <doc>I253/100 variant: Squitter data (1 data byte, excluding length)</doc>
      <field name="rx-channel" type="cat253-sq-rx-channel">
        <doc>Squitter receiving channel: 0 = SUM, 1 = DIFF, 2 = SUM+DIFF</doc>
      </field>
      <reserved bits="2"/>
      <field name="ms-squitter" type="cat253-sq-ms-squitter">
        <doc>Mode S Squitter</doc>
      </field>
      <field name="m5-squitter" type="cat253-sq-m5-squitter">
        <doc>Mode 5 Squitter</doc>
      </field>
    </struct>

    <!-- =======================================================================
         Cat253BitReport - I100 variant: BIT Report data
         16 data bytes (UZUNLUK/length byte not included):

         Octet 1 (of data): bit-type(4) + success-state(4)
         Octet 2: antenna-general(4) + antenna-scan-error(4)
         Octet 3: reserved(4) + power-source-general(4)
         Octet 4: ctrl-unit-general(2) + kb-crypto-comm(2) + kb-rtc(2) + kb-heat-warning(2)
         Octet 5: bottom-band-general(4) + tb-ctrl-comm(2) + tb-config-upload(2)
         Octet 6: vswr-general(2) + vswr-sum(2) + vswr-diff(2) + vswr-omni(2)
         Octet 7: reserved(2) + afb-general(4) + afb-main-synth(2)
         Octet 8: afb-bit-synth(2) + afb-total-ch(2) + afb-diff-ch(2) + afb-omni-ch(2)
         Octet 9: rfgyb-general(4) + rfgyb-total-pwr(2) + rfgyb-diff-pwr(2)
         Octet 10: rfgyb-omni-pwr(2) + rfgyb-heat-warning(2) + crypto-general(4)
         Octets 11-16: reserved(8) x 6
         ======================================================================= -->
    <struct name="Cat253BitReport">
      <doc>I253/100 variant: BIT Report data (16 data bytes, excluding length)</doc>

      <!-- Octet 1 -->
      <field name="bit-type" type="cat253-br-bit-type">
        <doc>BIT Type</doc>
      </field>
      <field name="success-state" type="cat253-br-success-state">
        <doc>Success State</doc>
      </field>

      <!-- Octet 2 -->
      <field name="antenna-general" type="cat253-br-antenna-general">
        <doc>Antenna General Response</doc>
      </field>
      <field name="antenna-scan-error" type="cat253-br-antenna-scan-error">
